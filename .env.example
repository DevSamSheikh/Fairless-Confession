# Supabase (required for backend server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=5000

# Frontend (Expo Go): set to your PC's IP so the phone can reach the backend (same Wi‑Fi).
# Find IP: Windows: ipconfig → IPv4   Mac/Linux: ifconfig or ip addr
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000
